@model WaterService.Models.MeterReading

@{
    ViewData["Title"] = "Chỉnh sửa chỉ số nước";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Chỉnh sửa chỉ số nước</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CustomerId" class="form-label">Khách hàng</label>
                                    <select asp-for="CustomerId" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.Customers, "Id", "CustomerCode"))">
                                        <option value="">-- Chọn khách hàng --</option>
                                    </select>
                                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Year" class="form-label">Năm</label>
                                    <input asp-for="Year" class="form-control" />
                                    <span asp-validation-for="Year" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quarter" class="form-label">Quý</label>
                                    <select asp-for="Quarter" class="form-select">
                                        <option value="1">Quý 1</option>
                                        <option value="2">Quý 2</option>
                                        <option value="3">Quý 3</option>
                                        <option value="4">Quý 4</option>
                                    </select>
                                    <span asp-validation-for="Quarter" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UnitPrice" class="form-label">Đơn giá</label>
                                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="OldIndex" class="form-label">Chỉ số cũ</label>
                                    <input asp-for="OldIndex" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="OldIndex" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="NewIndex" class="form-label">Chỉ số mới</label>
                                    <input asp-for="NewIndex" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="NewIndex" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="alert alert-info">
                                <strong>Lưu ý:</strong> Hệ thống sẽ tự động cập nhật hóa đơn khi lưu chỉ số nước.
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary me-md-2">Hủy</a>
                            <button type="submit" class="btn btn-primary">Cập nhật chỉ số nước</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

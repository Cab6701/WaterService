@model WaterService.Models.MeterReading
@using WaterService.Extensions

@{
    ViewData["Title"] = "Chi tiết chỉ số nước";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Chi tiết chỉ số nước</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Mã khách hàng:</dt>
                        <dd class="col-sm-9">@Model.Customer.CustomerCode</dd>

                        <dt class="col-sm-3">Tên khách hàng:</dt>
                        <dd class="col-sm-9">@Model.Customer.Name</dd>

                        <dt class="col-sm-3">Quý:</dt>
                        <dd class="col-sm-9">Quý @Model.Quarter</dd>

                        <dt class="col-sm-3">Năm:</dt>
                        <dd class="col-sm-9">@Model.Year</dd>

                        <dt class="col-sm-3">Chỉ số cũ:</dt>
                        <dd class="col-sm-9">@Model.OldIndex.ToString("N0")</dd>

                        <dt class="col-sm-3">Chỉ số mới:</dt>
                        <dd class="col-sm-9">@Model.NewIndex.ToString("N0")</dd>

                        <dt class="col-sm-3">Lượng tiêu thụ:</dt>
                        <dd class="col-sm-9">@Model.Consumption?.ToString("N0")</dd>

                        <dt class="col-sm-3">Đơn giá:</dt>
                        <dd class="col-sm-9">@Model.UnitPrice.ToString("C0")</dd>

                        <dt class="col-sm-3">Tổng tiền:</dt>
                        <dd class="col-sm-9">@Model.TotalAmount?.ToString("C0")</dd>

                        <dt class="col-sm-3">Ngày tạo:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Ngày cập nhật:</dt>
                        <dd class="col-sm-9">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>

            @if (Model.Invoice != null)
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Thông tin hóa đơn</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Số hóa đơn:</dt>
                            <dd class="col-sm-9">@Model.Invoice.InvoiceNumber</dd>

                            <dt class="col-sm-3">Trạng thái:</dt>
                            <dd class="col-sm-9">
                                <span class="badge badge-@(Model.Invoice.Status switch {
                                    InvoiceStatus.Paid => "success",
                                    InvoiceStatus.Pending => "warning",
                                    InvoiceStatus.Overdue => "danger",
                                    InvoiceStatus.Cancelled => "secondary",
                                    _ => "secondary"
                                })">
                                    @Model.Invoice.Status?.GetDisplayName()
                                </span>
                            </dd>

                            <dt class="col-sm-3">Ngày đến hạn:</dt>
                            <dd class="col-sm-9">@Model.Invoice.DueDate.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-3">Ngày thanh toán:</dt>
                            <dd class="col-sm-9">@(Model.Invoice.PaidDate?.ToString("dd/MM/yyyy") ?? "Chưa thanh toán")</dd>

                            <dt class="col-sm-3">Tổng tiền:</dt>
                            <dd class="col-sm-9">@Model.Invoice.TotalAmount.ToString("C0")</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Thao tác</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

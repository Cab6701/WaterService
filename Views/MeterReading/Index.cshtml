@model WaterService.Controllers.MeterReadingIndexViewModel
@using WaterService.Extensions

@{
    ViewData["Title"] = "Danh sách chỉ số nước";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Danh sách chỉ số nước</h4>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Tạo chỉ số nước mới
                    </a>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" class="mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Khách hàng</label>
                                <select name="customerId" class="form-select">
                                    <option value="">-- Tất cả khách hàng --</option>
                                    @foreach (var customer in ViewBag.Customers ?? new List<object>())
                                    {
                                        <option value="@customer.Id" selected="@(Model.CustomerId == customer.Id)">@customer.CustomerCode - @customer.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Quý</label>
                                <select name="quarter" class="form-select">
                                    <option value="1" selected="@(Model.Quarter == 1)">Quý 1</option>
                                    <option value="2" selected="@(Model.Quarter == 2)">Quý 2</option>
                                    <option value="3" selected="@(Model.Quarter == 3)">Quý 3</option>
                                    <option value="4" selected="@(Model.Quarter == 4)">Quý 4</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Năm</label>
                                <input type="number" name="year" class="form-control" value="@Model.Year" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-primary">Lọc</button>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-grid">
                                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                                </div>
                            </div>
                        </div>
                    </form>

                    <!-- Results -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Mã KH</th>
                                    <th>Tên khách hàng</th>
                                    <th>Quý</th>
                                    <th>Năm</th>
                                    <th>Chỉ số cũ</th>
                                    <th>Chỉ số mới</th>
                                    <th>Tiêu thụ</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái HĐ</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MeterReadings)
                                {
                                    <tr>
                                        <td>@item.Customer.CustomerCode</td>
                                        <td>@item.Customer.Name</td>
                                        <td>Quý @item.Quarter</td>
                                        <td>@item.Year</td>
                                        <td>@item.OldIndex.ToString("N0")</td>
                                        <td>@item.NewIndex.ToString("N0")</td>
                                        <td>@item.Consumption?.ToString("N0")</td>
                                        <td>@item.TotalAmount?.ToString("C0")</td>
                                        <td>
                                            @if (item.Invoice != null)
                                            {
                                                <span class="badge badge-@(item.Invoice.Status switch {
                                                    InvoiceStatus.Paid => "success",
                                                    InvoiceStatus.Pending => "warning",
                                                    InvoiceStatus.Overdue => "danger",
                                                    InvoiceStatus.Cancelled => "secondary",
                                                    _ => "secondary"
                                                })">
                                                    @item.Invoice.Status?.GetDisplayName()
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Chưa có HĐ</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.MeterReadings.Any())
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">Không có dữ liệu chỉ số nước nào.</p>
                        </div>
                    }

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(Model.CurrentPage - 1)&customerId=@Model.CustomerId&quarter=@Model.Quarter&year=@Model.Year">Trước</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&customerId=@Model.CustomerId&quarter=@Model.Quarter&year=@Model.Year">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(Model.CurrentPage + 1)&customerId=@Model.CustomerId&quarter=@Model.Quarter&year=@Model.Year">Sau</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                    <div class="text-muted text-center">
                        Hiển thị @Model.MeterReadings.Count trong tổng số @Model.TotalCount bản ghi
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

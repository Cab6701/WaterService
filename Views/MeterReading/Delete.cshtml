@model WaterService.Models.MeterReading
@using WaterService.Extensions

@{
    ViewData["Title"] = "Xóa chỉ số nước";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Xác nhận xóa chỉ số nước</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa chỉ số nước này không? 
                        Hóa đơn liên kết cũng sẽ bị xóa.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Mã khách hàng:</dt>
                        <dd class="col-sm-9">@Model.Customer.CustomerCode</dd>

                        <dt class="col-sm-3">Tên khách hàng:</dt>
                        <dd class="col-sm-9">@Model.Customer.Name</dd>

                        <dt class="col-sm-3">Quý:</dt>
                        <dd class="col-sm-9">Quý @Model.Quarter</dd>

                        <dt class="col-sm-3">Năm:</dt>
                        <dd class="col-sm-9">@Model.Year</dd>

                        <dt class="col-sm-3">Chỉ số cũ:</dt>
                        <dd class="col-sm-9">@Model.OldIndex.ToString("N0")</dd>

                        <dt class="col-sm-3">Chỉ số mới:</dt>
                        <dd class="col-sm-9">@Model.NewIndex.ToString("N0")</dd>

                        <dt class="col-sm-3">Lượng tiêu thụ:</dt>
                        <dd class="col-sm-9">@Model.Consumption?.ToString("N0")</dd>

                        <dt class="col-sm-3">Tổng tiền:</dt>
                        <dd class="col-sm-9">@(Model.TotalAmount?.ToString("N3").Replace(",", ".") + " VNĐ")</dd>
                    </dl>

                    @if (Model.Invoice != null)
                    {
                        <div class="mt-3">
                            <h5>Hóa đơn liên kết:</h5>
                            <dl class="row">
                                <dt class="col-sm-3">Số hóa đơn:</dt>
                                <dd class="col-sm-9">@Model.Invoice.InvoiceNumber</dd>

                                <dt class="col-sm-3">Trạng thái:</dt>
                                <dd class="col-sm-9">
                                    <span class="badge badge-@(Model.Invoice.Status switch {
                                        InvoiceStatus.Paid => "success",
                                        InvoiceStatus.Pending => "warning",
                                        InvoiceStatus.Overdue => "danger",
                                        InvoiceStatus.Cancelled => "secondary",
                                        _ => "secondary"
                                    })">
                                        @Model.Invoice.Status?.GetDisplayName()
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    }

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input asp-for="Id" type="hidden" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary me-md-2">Hủy</a>
                            <button type="submit" class="btn btn-danger">Xóa chỉ số nước</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

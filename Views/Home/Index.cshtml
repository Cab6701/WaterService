@{
    ViewData["Title"] = "Trang chủ";
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5">
                <h1 class="display-4 text-primary">
                    <i class="fas fa-tint"></i> Hệ thống quản lý nước sạch
                </h1>
                <p class="lead">Tổ dịch vụ nước sạch Bình Lãng</p>
            </div>

            @if (!string.IsNullOrEmpty(username))
            {
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">
                        <i class="fas fa-user-check"></i> Chào mừng @Context.Session.GetString("DisplayName")!
                    </h4>
                    <p>Bạn đã đăng nhập với quyền <strong>@(role == "Admin" ? "Quản trị viên" : "Người dùng")</strong></p>
                    <hr>
                    @if (role == "Admin")
                    {
                        <p class="mb-0">
                            <a href="@Url.Action("Index", "Customer")" class="btn btn-primary">
                                <i class="fas fa-users"></i> Quản lý khách hàng
                            </a>
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            <a href="@Url.Action("WaterInquiry", "Account")" class="btn btn-info">
                                <i class="fas fa-search"></i> Tra cứu hóa đơn nước
                            </a>
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="fas fa-user-shield fa-3x text-primary mb-3"></i>
                                <h5 class="card-title">Quản trị viên</h5>
                                <p class="card-text">Đăng nhập để quản lý khách hàng, hóa đơn và báo cáo</p>
                                <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập Admin
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="fas fa-search fa-3x text-info mb-3"></i>
                                <h5 class="card-title">Người dùng</h5>
                                <p class="card-text">Tra cứu thông tin hóa đơn nước theo mã khách hàng</p>
                                <a href="@Url.Action("Login", "Account")" class="btn btn-info">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập User
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-5">
                <div class="text-center mb-4">
                    <h3>
                        <i class="fas fa-info-circle"></i> Thông tin hệ thống
                    </h3>
                    <a href="@Url.Action("Instructions", "Account")" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-book"></i> Hướng dẫn sử dụng
                    </a>
                    <a href="@Url.Action("SeedData", "Account")" class="btn btn-outline-warning btn-sm">
                        <i class="fas fa-database"></i> Tạo dữ liệu mẫu
                    </a>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="fas fa-users fa-2x text-success mb-2"></i>
                                <h6>Quản lý khách hàng</h6>
                                <small class="text-muted">Theo dõi thông tin khách hàng</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="fas fa-tachometer-alt fa-2x text-warning mb-2"></i>
                                <h6>Đọc đồng hồ nước</h6>
                                <small class="text-muted">Ghi nhận chỉ số đồng hồ</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="fas fa-file-invoice fa-2x text-primary mb-2"></i>
                                <h6>Hóa đơn & Thanh toán</h6>
                                <small class="text-muted">Tạo và quản lý hóa đơn</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
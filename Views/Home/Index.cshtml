@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center">
    <h1 class="display-4">Chào mừng đến với WaterService</h1>
    <p class="lead">Hệ thống quản lý dịch vụ cấp nước toàn diện</p>
</div>

<div class="row mt-5">
    <!-- Quản lý khách hàng -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Quản lý khách hàng</h5>
                <p class="card-text">Quản lý tài khoản khách hàng, xem chi tiết và theo dõi lịch sử sử dụng dịch vụ.</p>
                <a href="@Url.Action("Index", "Customer")" class="btn btn-primary">
                    <i class="fas fa-arrow-right"></i> Quản lý khách hàng
                </a>
            </div>
        </div>
    </div>

    <!-- Ghi chỉ số nước -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-tachometer-alt fa-3x text-success mb-3"></i>
                <h5 class="card-title">Ghi chỉ số nước</h5>
                <p class="card-text">Ghi nhận và theo dõi chỉ số đồng hồ nước để tính hóa đơn chính xác.</p>
                <a href="#" class="btn btn-success disabled">
                    <i class="fas fa-arrow-right"></i> Sắp ra mắt
                </a>
            </div>
        </div>
    </div>

    <!-- Hóa đơn & Thanh toán -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="fas fa-file-invoice fa-3x text-warning mb-3"></i>
                <h5 class="card-title">Hóa đơn & Thanh toán</h5>
                <p class="card-text">Tạo hóa đơn, theo dõi thanh toán và quản lý chu kỳ thu tiền.</p>
                <a href="#" class="btn btn-warning disabled">
                    <i class="fas fa-arrow-right"></i> Sắp ra mắt
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Tổng quan hệ thống
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Các tính năng hiện có -->
                    <div class="col-md-6">
                        <h6>Các tính năng hiện có:</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success"></i> Đăng ký & Quản lý khách hàng</li>
                            <li><i class="fas fa-check text-success"></i> Tìm kiếm & Lọc khách hàng</li>
                            <li><i class="fas fa-check text-success"></i> Thao tác hàng loạt</li>
                            <li><i class="fas fa-check text-success"></i> Giao diện tương thích trên mọi thiết bị</li>
                        </ul>
                    </div>

                    <!-- Tính năng sắp ra mắt -->
                    <div class="col-md-6">
                        <h6>Sắp ra mắt:</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-clock text-warning"></i> Quản lý chỉ số đồng hồ nước</li>
                            <li><i class="fas fa-clock text-warning"></i> Tự động tính hóa đơn</li>
                            <li><i class="fas fa-clock text-warning"></i> Theo dõi thanh toán</li>
                            <li><i class="fas fa-clock text-warning"></i> Báo cáo & Phân tích</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@model WaterService.Models.TierPrice

@{
    ViewData["Title"] = "Chỉnh sửa giá bậc thang";
}

<div class="modal fade" id="tierPriceModal" tabindex="-1" aria-labelledby="tierPriceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tierPriceModalLabel">
                    <i class="fas fa-cog"></i> Chỉnh sửa giá bậc thang
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="tierPriceForm" asp-action="Edit" asp-controller="TierPrice" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Tier1Price" class="form-label">
                            <i class="fas fa-layer-group"></i> Giá bậc 1 (≤ 30 m³)
                        </label>
                        <div class="input-group">
                            <input asp-for="Tier1Price" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Tier1Price" class="text-danger"></span>
                        <small class="form-text text-muted">Giá cho mỗi m³ từ 1 đến 30 m³</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tier2Price" class="form-label">
                            <i class="fas fa-layer-group"></i> Giá bậc 2 (31-60 m³)
                        </label>
                        <div class="input-group">
                            <input asp-for="Tier2Price" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Tier2Price" class="text-danger"></span>
                        <small class="form-text text-muted">Giá cho mỗi m³ từ 31 đến 60 m³</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tier3Price" class="form-label">
                            <i class="fas fa-layer-group"></i> Giá bậc 3 (> 60 m³)
                        </label>
                        <div class="input-group">
                            <input asp-for="Tier3Price" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Tier3Price" class="text-danger"></span>
                        <small class="form-text text-muted">Giá cho mỗi m³ trên 60 m³</small>
                    </div>

                    <div class="alert alert-info">
                        <strong><i class="fas fa-info-circle"></i> Lưu ý:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Giá bậc thang sẽ được áp dụng cho tất cả các hóa đơn mới</li>
                            <li>Các hóa đơn đã tạo sẽ không bị thay đổi</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#tierPriceForm').on('submit', function (e) {
                e.preventDefault();

                var form = $(this);
                var formData = form.serialize();

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            $('#tierPriceModal').modal('hide');
                            // Hiển thị thông báo thành công
                            if (typeof showAlert === 'function') {
                                showAlert('success', response.message);
                            } else {
                                // Tạo alert tạm thời nếu hàm không tồn tại
                                var alertDiv = $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                    response.message +
                                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                    '</div>');
                                $('.container').first().prepend(alertDiv);
                                setTimeout(function () {
                                    alertDiv.fadeOut(function () { $(this).remove(); });
                                }, 5000);
                            }
                        } else {
                            alert('Có lỗi xảy ra: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi lưu giá bậc thang.');
                    }
                });
            });

            // Load giá hiện tại khi mở modal
            $('#tierPriceModal').on('show.bs.modal', function () {
                $.ajax({
                    url: '@Url.Action("GetCurrent", "TierPrice")',
                    type: 'GET',
                    success: function (data) {
                        $('#Tier1Price').val(data.tier1Price);
                        $('#Tier2Price').val(data.tier2Price);
                        $('#Tier3Price').val(data.tier3Price);
                    }
                });
            });
        });
    </script>
}

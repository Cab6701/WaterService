@model WaterService.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="customer-details">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 mb-0">Chi tiết khách hàng</h1>
                <p class="text-muted mb-0">Thông tin đầy đủ <strong>@Model.CustomerCode</strong></p>
            </div>
            <div class="btn-group">
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Chỉnh sửa khách hàng
                </a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-list"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Basic Information -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-user"></i> Thông tin cơ bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Mã khách hàng</small>
                        </div>
                        <div class="col-sm-8">
                            <strong>@Model.CustomerCode</strong>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Tên khách hàng</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.Name
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Số điện thoại</small>
                        </div>
                        <div class="col-sm-8">
                            <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-map-marker-alt"></i> Địa chỉ
                    </h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Address</p>
                </div>
            </div>

            <!-- Account Information -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-info-circle"></i>Thông tin tài khoản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Tạo</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Cập nhật lần cuối</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.UpdatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row">
                            <div class="col-sm-4">
                                <small class="text-muted">Ghi chú</small>
                            </div>
                            <div class="col-sm-8">
                                <p class="mb-0">@Model.Notes</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Billing and Service Information -->
        <div class="col-lg-8">
            <!-- Billing Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-receipt"></i> Tóm tắt thanh toán
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-primary mb-1">₫0</h4>
                                <small class="text-muted">Số dư hiện tại</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-success mb-1">₫0</h4>
                                <small class="text-muted">Tổng số tiền đã trả</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-info mb-1">0</h4>
                                <small class="text-muted">Tổng hóa đơn</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <h4 class="text-warning mb-1">0</h4>
                            <small class="text-muted">Hóa đơn quá hạn</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Invoices -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-file-invoice"></i> Hóa đơn gần đây
                    </h6>
                    <a href="#" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-plus"></i> Hóa đơn mới
                    </a>
                </div>
                <div class="card-body">
                    <div class="text-center py-4">
                        <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">Không tìm thấy hóa đơn</h6>
                        <p class="text-muted mb-0">Khách hàng này chưa có hóa đơn nào.</p>
                        <a href="#" class="btn btn-sm btn-primary mt-2">
                            <i class="fas fa-plus"></i> Tạo hóa đơn đầu tiên
                        </a>
                    </div>
                </div>
            </div>

            <!-- Meter Reading History -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-tachometer-alt"></i> Lịch sử đọc đồng hồ
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Bảng lịch sử chỉ số nước -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Quý</th>
                                    <th>Năm</th>
                                    <th>Chỉ số cũ</th>
                                    <th>Chỉ số mới</th>
                                    <th>Lượng tiêu thụ</th>
                                    <th>Tổng tiền</th>
                                    <th>Ngày nhập</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MeterReadings != null && Model.MeterReadings.Any())
                                {
                                    foreach (var reading in Model.MeterReadings.OrderByDescending(r =>
                                    r.Year).ThenByDescending(r => r.Quarter))
                                    {
                                        <tr>
                                            <td>@reading.Quarter</td>
                                            <td>@reading.Year</td>
                                            <td>@reading.OldIndex.ToString("N0")</td>
                                            <td>@reading.NewIndex.ToString("N0")</td>
                                            <td>@(reading.Consumption?.ToString("N0") ?? "0") m³</td>
                                            <td>@(reading.TotalAmount?.ToString("N0") ?? "0") VNĐ</td>
                                            <td>@reading.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">Chưa có chỉ số nước nào</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-credit-card"></i> Lịch sử thanh toán
                    </h6>
                </div>
                <div class="card-body">
                    <div class="text-center py-4">
                        <i class="fas fa-credit-card fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">Không tìm thấy khoản thanh toán nào.</h6>
                        <p class="text-muted mb-0">Khách hàng này chưa có bất kỳ lịch sử thanh toán nào.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any specific JavaScript for the details page here
            console.log('Customer details page loaded for: @Model.CustomerCode');
        });
    </script>
}
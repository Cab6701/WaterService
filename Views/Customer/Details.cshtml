@model WaterService.Models.Customer
@using WaterService.Models
@using WaterService.Extensions
@{
    ViewData["Title"] = "Customer Details";
    var totalDue = ViewBag.TotalDue as decimal? ?? 0m;
    var totalPaid = ViewBag.TotalPaid as decimal? ?? 0m;
    var totalInvoices = ViewBag.TotalInvoices as int? ?? 0;
    var overdueCount = ViewBag.OverdueCount as int? ?? 0;
    var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Username")) && Context.Session.GetString("Role") ==
    "Admin";
}

<div class="customer-details">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 mb-0">Chi tiết khách hàng</h1>
                <p class="text-muted mb-0">Thông tin đầy đủ <strong>@Model.CustomerCode</strong></p>
            </div>
            <div class="btn-group">
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Chỉnh sửa khách hàng
                </a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-list"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Basic Information -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-user"></i> Thông tin cơ bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Mã khách hàng</small>
                        </div>
                        <div class="col-sm-8">
                            <strong>@Model.CustomerCode</strong>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Tên khách hàng</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.Name
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Số điện thoại</small>
                        </div>
                        <div class="col-sm-8">
                            <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-map-marker-alt"></i> Địa chỉ
                    </h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Address</p>
                </div>
            </div>

            <!-- Account Information -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-info-circle"></i>Thông tin tài khoản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Tạo</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <small class="text-muted">Cập nhật lần cuối</small>
                        </div>
                        <div class="col-sm-8">
                            @Model.UpdatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row">
                            <div class="col-sm-4">
                                <small class="text-muted">Ghi chú</small>
                            </div>
                            <div class="col-sm-8">
                                <p class="mb-0">@Model.Notes</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Billing and Service Information -->
        <div class="col-lg-8">
            <!-- Billing Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-receipt"></i> Tóm tắt thanh toán
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-primary mb-1">@totalDue.ToString("N0") ₫</h4>
                                <small class="text-muted">Số dư chưa thanh toán</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-success mb-1">@totalPaid.ToString("N0") ₫</h4>
                                <small class="text-muted">Tổng số tiền đã trả</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border-end">
                                <h4 class="text-info mb-1">@totalInvoices</h4>
                                <small class="text-muted">Tổng hóa đơn</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <h4 class="text-warning mb-1">@overdueCount</h4>
                            <small class="text-muted">Hóa đơn quá hạn</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Invoices -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-file-invoice"></i> Hóa đơn
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Invoices != null && Model.Invoices.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-light text-center align-middle">
                                    <tr>
                                        <th class="text-center align-middle">Mã hóa đơn</th>
                                        <th class="text-center align-middle">Quý/Năm</th>
                                        <th class="text-center align-middle">Ngày đến hạn</th>
                                        <th class="text-center align-middle">Trạng thái</th>
                                        <th class="text-center align-middle">Tổng tiền</th>
                                        <th class="text-center align-middle">Ngày thanh toán</th>
                                        @if (isAdmin)
                                        {
                                            <th class="text-center align-middle">Thao tác</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.Invoices.OrderByDescending(i => i.DueDate))
                                    {
                                        var reading = invoice.WaterMeterReading;
                                        <tr>
                                            <td>@invoice.InvoiceNumber</td>
                                            <td>
                                                @(reading != null ? $"Q{reading.Quarter}/{reading.Year}" : "-")
                                            </td>
                                            <td>@invoice.DueDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <span
                                                    class="badge px-3 py-2
                                                                                                    @(invoice.Status == InvoiceStatus.Paid ? "bg-success" :
                                                                                                                                                                                                                                                                                                                                                                                invoice.Status == InvoiceStatus.Overdue ? "bg-danger" :
                                                                                                                                                                                                                                                                                                                                                                                invoice.Status == InvoiceStatus.Pending ? "bg-warning text-dark" :
                                                                                                                                                                                                                                                                                                                                                                                "bg-secondary")">
                                                    @(invoice.Status?.GetDisplayName() ?? "Chưa xác định")
                                                </span>
                                            </td>
                                            <td>@invoice.TotalAmount.ToString("N0") ₫</td>
                                            <td>@(invoice.PaidDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            @if (isAdmin)
                                            {
                                                <td>
                                                    <form asp-action="UpdateInvoiceStatus" asp-controller="Customer" method="post"
                                                        class="d-flex gap-2 align-items-center">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                        <select name="status" class="form-select form-select-sm"
                                                            style="max-width: 150px;">
                                                            @foreach (InvoiceStatus status in Enum.GetValues(typeof(InvoiceStatus)))
                                                            {
                                                                <option value="@( (int)status )"
                                                                    selected="@(invoice.Status == status ? "selected" : null)">
                                                                    @status.GetDisplayName()
                                                                </option>
                                                            }
                                                        </select>
                                                        <button type="submit" class="btn btn-sm btn-primary">
                                                            <i class="fas fa-save"></i> Cập nhật
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                            <h6 class="text-muted">Không tìm thấy hóa đơn</h6>
                            <p class="text-muted mb-0">Khách hàng này chưa có hóa đơn nào.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Meter Reading History -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-tachometer-alt"></i> Lịch sử đọc đồng hồ
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Bảng lịch sử chỉ số nước -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light text-center align-middle">
                                <tr>
                                    <th class="text-center align-middle">Quý</th>
                                    <th class="text-center align-middle">Năm</th>
                                    <th class="text-center align-middle">Chỉ số cũ</th>
                                    <th class="text-center align-middle">Chỉ số mới</th>
                                    <th class="text-center align-middle">Lượng tiêu thụ</th>
                                    <th class="text-center align-middle">Tổng tiền</th>
                                    <th class="text-center align-middle">Ngày nhập</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MeterReadings != null && Model.MeterReadings.Any())
                                {
                                    foreach (var reading in Model.MeterReadings.OrderByDescending(r =>
                                    r.Year).ThenByDescending(r => r.Quarter))
                                    {
                                        <tr>
                                            <td>@reading.Quarter</td>
                                            <td>@reading.Year</td>
                                            <td>@reading.OldIndex.ToString("N0")</td>
                                            <td>@reading.NewIndex.ToString("N0")</td>
                                            <td>@(reading.Consumption?.ToString("N0") ?? "0") m³</td>
                                            <td>@(reading.Invoice != null ? reading.Invoice.TotalAmount.ToString("N0") : "0")
                                                VNĐ</td>
                                            <td>@reading.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">Chưa có chỉ số nước nào</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-credit-card"></i> Lịch sử thanh toán
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Invoices != null && Model.Invoices.Any(i => i.Status == InvoiceStatus.Paid))
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-light text-center align-middle">
                                    <tr>
                                        <th class="text-center align-middle">Mã hóa đơn</th>
                                        <th class="text-center align-middle">Ngày thanh toán</th>
                                        <th class="text-center align-middle">Số tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.Invoices.Where(i => i.Status ==
                                                                    InvoiceStatus.Paid).OrderByDescending(i => i.PaidDate))
                                    {
                                        <tr>
                                            <td>@invoice.InvoiceNumber</td>
                                            <td>@(invoice.PaidDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>@invoice.TotalAmount.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-credit-card fa-3x text-muted mb-3"></i>
                            <h6 class="text-muted">Không tìm thấy khoản thanh toán nào.</h6>
                            <p class="text-muted mb-0">Khách hàng này chưa có bất kỳ lịch sử thanh toán nào.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any specific JavaScript for the details page here
            console.log('Customer details page loaded for: @Model.CustomerCode');
        });
    </script>
}
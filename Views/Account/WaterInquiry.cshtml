@model WaterService.Models.WaterInquiryViewModel
@{
    ViewData["Title"] = "Tra cứu hóa đơn nước";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4><i class="fas fa-search"></i> Tra cứu hóa đơn nước</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="alert">
                        <h5 class="alert-heading">
                            <i class="fas fa-info-circle"></i> Hướng dẫn sử dụng
                        </h5>
                        <p class="mb-0">
                            <strong>Để tra cứu hóa đơn nước:</strong><br>
                            1. Nhập <strong>số điện thoại</strong> của bạn (ví dụ: 0123456789, 0987654321)<br>
                            2. Chọn <strong>quý</strong> và <strong>năm</strong> muốn tra cứu<br>
                            3. Nhấn nút <strong>"Tra cứu"</strong> để xem thông tin<br>
                            <br>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i>
                                <strong>Số điện thoại:</strong> Nhập số điện thoại đã đăng ký với hệ thống (10-11 chữ số)<br>
                                <i class="fas fa-user-shield"></i>
                                <strong>Quản trị viên:</strong> Sử dụng nút "Đăng nhập Admin" ở góc phải để quản lý hệ thống
                            </small>
                        </p>
                    </div>

                    <!-- Thông tin thanh toán -->
                    @*<div class="alert alert-warning" role="alert">
                        <div class="row">
                            <div class="col-md-8">
                                <h6 class="alert-heading">
                                    <i class="fas fa-credit-card"></i> Thông tin thanh toán
                                </h6>
                                <p class="mb-2"><strong>Vui lòng thanh toán trước hạn thanh toán theo thông tin dưới đây:</strong></p>

                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Chủ TK:</strong> KHUONG TUNG AN</p>
                                        <p class="mb-1"><strong>Số TK:</strong> 8888912997587</p>
                                        <p class="mb-1"><strong>Ngân hàng:</strong> Agribank - CN Tứ Kỳ, HD</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Nội dung chuyển khoản:</strong></p>
                                        <span>Số điện thoại đã đăng ký</span>
                                    </div>
                                </div>

                                <p class="mb-0 mt-2 text-danger">
                                    <i class="fas fa-phone"></i>
                                    <strong>Gửi ảnh xác nhận thanh toán qua Hotline/Zalo: 0912997587</strong>
                                </p>
                            </div>
                            <div class="col-md-4 text-center">
                                <h6 class="text-danger mb-2">
                                    <i class="fas fa-qrcode"></i> QUÉT MÃ QR
                                </h6>
                                <img src="~/images/qrcode.jpg" alt="Mã QR thanh toán" class="img-fluid" style="max-width: 150px;">
                            </div>
                        </div>
                    </div>*@
                    <form asp-action="WaterInquiry" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Quarter" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        <select asp-for="Quarter" class="form-select">
                                            <option value="1">Quý 1</option>
                                            <option value="2">Quý 2</option>
                                            <option value="3">Quý 3</option>
                                            <option value="4">Quý 4</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="Quarter" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Year" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                        <select asp-for="Year" class="form-select">
                                            @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 5; year--)
                                            {
                                                <option value="@year">@year</option>
                                            }
                                        </select>
                                    </div>
                                    <span asp-validation-for="Year" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-info btn-lg">
                                <i class="fas fa-search"></i> Tra cứu
                            </button>
                        </div>
                    </form>

                    @if (ViewBag.Customer != null && ViewBag.MeterReading != null)
                    {
                        <hr class="my-4">

                        var customer = ViewBag.Customer as WaterService.Models.Customer;
                        var meterReading = ViewBag.MeterReading as WaterService.Models.MeterReading;
                        var invoices = ViewBag.Invoices as List<WaterService.Models.Invoice>;
                        var firstInvoice = invoices?.FirstOrDefault();
                        var tierBreakdown = ViewBag.TierBreakdown as List<dynamic>;
                        var totalAmount = firstInvoice?.TotalAmount ?? 0;
                        var dueDate = firstInvoice?.DueDate ?? DateTime.Now;
                        var consumption = meterReading.Consumption ?? 0;

                        <div class="row">
                            <!-- Cột trái: THÔNG BÁO -->
                            <div class="col-md-6 mb-4">
                                <div class="card border">
                                    <div class="card-header bg-white">
                                        <h5 class="mb-0"><strong>THÔNG BÁO</strong></h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-3">
                                            <strong>Tổ dịch vụ nước sạch Bình Lãng xin thông báo đến Quý khách hàng</strong>
                                        </p>

                                        <div class="mb-3">
                                            <p class="mb-1"><strong>Họ và tên:</strong> @customer.Name</p>
                                            <p class="mb-1"><strong>Mã khách hàng:</strong> @customer.CustomerCode</p>
                                        </div>

                                        <div class="mb-3">
                                            <h6 class="text-primary">Sử dụng nước Quý @ViewBag.Quarter năm @ViewBag.Year</h6>
                                            <p class="mb-1"><strong>Chỉ số đầu:</strong> @meterReading.OldIndex.ToString("N0")</p>
                                            <p class="mb-1"><strong>Chỉ số cuối:</strong> @meterReading.NewIndex.ToString("N0")</p>
                                            <p class="mb-1"><strong>Số thực tế sử dụng:</strong> @consumption.ToString("N0")</p>
                                        </div>

                                        <div class="alert alert-info mb-3">
                                            <h6 class="mb-2"><strong>Tổng tiền phải thanh toán</strong></h6>
                                            <h4 class="text-primary mb-0">@totalAmount.ToString("N0")₫</h4>
                                        </div>

                                        <div class="mb-3">
                                            <p class="mb-2">
                                                <strong>Vui lòng thanh toán trước ngày @dueDate.ToString("dd/MM/yyyy") theo thông tin dưới đây:</strong>
                                            </p>
                                            <div class="row">
                                                <div class="col-6">
                                                    <p class="mb-1"><strong>Chủ TK:</strong> KHUONG TUNG AN</p>
                                                    <p class="mb-1"><strong>Số TK:</strong> 8888912997587</p>
                                                    <p class="mb-1"><strong>Tại Ngân hàng:</strong> Agribank - CN Tứ Kỳ, HD</p>
                                                    <p class="mb-1"><strong>Nội dung chuyển khoản:</strong></p>
                                                    <span class="badge bg-info text-dark">@customer.CustomerCode</span>
                                                </div>
                                                <div class="col-6 text-center">
                                                    <p class="mb-2"><strong>QUÉT MÃ QR =></strong></p>
                                                    <img src="~/images/qrcode.jpg" alt="Mã QR thanh toán" class="img-fluid" style="max-width: 120px;">
                                                </div>
                                            </div>
                                        </div>

                                        <p class="mb-2 text-danger">
                                            <i class="fas fa-phone"></i>
                                            <strong>Gửi ảnh chụp màn hình xác nhận thanh toán qua Hotline/Zalo: 0912997587</strong>
                                        </p>

                                        <p class="mb-0"><strong>Xin trân trọng cảm ơn!</strong></p>

                                        <div class="mt-3 pt-3 border-top">
                                            <div class="row">
                                                <div class="col-6">
                                                    <span class="badge bg-warning text-dark">MÃ KH: @customer.CustomerCode</span>
                                                </div>
                                                <div class="col-6">
                                                    <span class="badge bg-success">SĐT: @customer.PhoneNumber</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cột phải: CHI TIẾT -->
                            <div class="col-md-6 mb-4">
                                <div class="card border">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0"><strong>CHI TIẾT</strong></h5>
                                    </div>
                                    <div class="card-body">
                                        <h6 class="mb-3">@customer.Name</h6>

                                        @if (tierBreakdown != null && tierBreakdown.Any())
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-bordered">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="text-center">Đơn giá</th>
                                                            <th class="text-center">Số khối sử dụng</th>
                                                            <th class="text-center">Thành tiền</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var tier in tierBreakdown)
                                                        {
                                                            <tr>
                                                                <td class="text-center">@tier.UnitPrice.ToString("N0") đ</td>
                                                                <td class="text-center">@tier.Consumption.ToString("N0")</td>
                                                                <td class="text-center">@tier.Amount.ToString("N0") đ</td>
                                                            </tr>
                                                        }
                                                        <tr class="table-info fw-bold">
                                                            <td colspan="2" class="text-end"><strong>Tổng tiền</strong></td>
                                                            <td class="text-center"><strong>@totalAmount.ToString("N0") đ</strong></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning">
                                                Không có dữ liệu chi tiết
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ViewBag.Customer != null)
                    {
                        <hr class="my-4">
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            Không có dữ liệu hóa đơn cho Quý @ViewBag.Quarter năm @ViewBag.Year
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}